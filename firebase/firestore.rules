rules_version = '2';

// I-Crash V2 institution/role-scoped Firestore rules.
// Model documented in docs/FIREBASE.md. Automated tests in
// firestore-tests/rules.test.mjs must pass before deploying any change here.
//
// Design notes:
// - Deny-by-default: every collection is closed unless explicitly opened.
// - Institution isolation: every path is rooted at institutions/{institutionId};
//   access always checks a membership document scoped to that institution.
// - No privilege escalation: a user can never write their own membership doc.
// - User types (D16, 30 Oct 2026): Super (platformAdmins marker, the I-Crash
//   team) and Admin (membership 'institutionAdmin', the institution's IT) see
//   and change everything in the institution; a Manager (membership
//   'manager'; the old 'user' role counts as Manager) sees only the carts
//   they're registered to (responsibleUsers) and has every cart action there
//   (stock, batches, cart state), but no structure, catalogue, users or
//   shifts.
// - Immutable audit trail: usageEvents/auditEvents are create-only, never
//   updated or deleted by clients (spec sections 18, 45, 60).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function membershipDoc(institutionId) {
      return get(/databases/$(database)/documents/institutions/$(institutionId)/memberships/$(request.auth.uid));
    }

    function isMember(institutionId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/institutions/$(institutionId)/memberships/$(request.auth.uid)) &&
        membershipDoc(institutionId).data.status == 'active';
    }

    function role(institutionId) {
      return membershipDoc(institutionId).data.role;
    }

    function hasRole(institutionId, roles) {
      return isMember(institutionId) && role(institutionId) in roles;
    }

    // D16: Admin or Super — everything in the institution.
    function isInstitutionAdmin(institutionId) {
      return hasRole(institutionId, ['institutionAdmin']) || isPlatformSuperAdmin();
    }

    function isAssignedToCart(institutionId, cartId) {
      return isMember(institutionId) &&
        exists(/databases/$(database)/documents/institutions/$(institutionId)/carts/$(cartId)/responsibleUsers/$(request.auth.uid));
    }

    // D16: the Admin, or a Manager registered to the cart. Whoever may read a
    // cart may also do every cart action on it (stock, batches, state).
    function canAccessCart(institutionId, cartId) {
      return isInstitutionAdmin(institutionId) || isAssignedToCart(institutionId, cartId);
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // P1/P2: `usedAt` is a Firestore-only marker (no column in DATABASE.md)
    // written with the first History event of a placement, on the placement,
    // its slot and its drawer. Rules can't query usageEvents, so this is how
    // they know a structure is in use. It may only go from absent to the
    // request time, and never change or disappear afterwards.
    function isUsed() {
      return 'usedAt' in resource.data;
    }

    function usedAtKept() {
      return ('usedAt' in resource.data)
        ? ('usedAt' in request.resource.data && request.resource.data.usedAt == resource.data.usedAt)
        : (!('usedAt' in request.resource.data) || request.resource.data.usedAt == request.time);
    }

    // Anyone who may record History on the cart may mark its structure used.
    function onlyMarksUsed() {
      return !('usedAt' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt']) &&
        request.resource.data.usedAt == request.time;
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // D20: a drawer's optional descriptive name is text of 1–50 characters.
    function drawerNameValid() {
      return !('name' in request.resource.data) ||
        (request.resource.data.name is string &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 50);
    }

    // P5 (no overfill) and DATABASE.md `0 ≤ currNumberCC ≤ maxNumberCC`,
    // `maxNumberCC > 0`. Mirrors InventoryRules.checkStock in the app.
    function stockWithinTarget(data) {
      return data.targetQuantity > 0 &&
        data.currentQuantity >= 0 &&
        data.currentQuantity <= data.targetQuantity;
    }

    // An update must leave the stock within its target, except that a
    // placement already overfilled before P5 (old data in the cloud
    // project) may still have its stock lowered, with the target unchanged.
    function stockUpdateAllowed() {
      return stockWithinTarget(request.resource.data) || (
        request.resource.data.currentQuantity >= 0 &&
        request.resource.data.currentQuantity < resource.data.currentQuantity &&
        request.resource.data.targetQuantity == resource.data.targetQuantity
      );
    }

    // Marker collection for platform-wide super admins. No Cloud Function
    // exists yet to manage it (spec section 7: Phase 1 has no Functions), so
    // it is provisioned manually via the Firebase console/Admin SDK and is
    // never writable by client rules.
    match /platformAdmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Lightweight denormalized pointer, one per (institution, member), kept
    // in sync with the canonical `memberships` doc below whenever it is
    // created/disabled. Exists ONLY so InstitutionRepository can run
    // `collectionGroup('memberIndex').where('uid', '==', myUid)` to answer
    // "which institutions do I belong to" (spec section 16), which a nested
    // `institutions/{id}/memberships/{uid}` rule cannot serve: Firestore
    // only authorizes a `collectionGroup()` query against a rule declared
    // with a `{path=**}` wildcard, not a nested exact-path rule.
    //
    // IMPORTANT emulator quirk, confirmed empirically (firebase-tools
    // 15.29.0): for a `list`/collection-group query, referencing the
    // trailing wildcard captured right after `{path=**}` (here, `{uid}`)
    // inside the `allow read` condition makes the whole query fail with a
    // "Null value error", even a trivial `uid == uid`. Reading the same
    // value from the document body instead (`resource.data.uid`) works
    // correctly, so every membership doc stores its own `uid` field
    // precisely so this comparison never needs the path wildcard for reads.
    // `create`/`update`/`delete` are single-document operations, not `list`,
    // so `path[1]` (the institutionId segment) resolves normally for them.
    match /{path=**}/memberIndex/{uid} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow create: if isInstitutionAdmin(path[1]) && request.resource.data.uid == uid;
      allow update, delete: if isInstitutionAdmin(path[1]);
    }

    // Enables `collectionGroup('assignments')` for the cross-cart dashboard
    // alerts (spec section 49 — expiring/expired products and stock below
    // its minimum, across every cart in an institution at once). Manager+
    // only, deliberately narrower than the nested per-cart rule below: a
    // `list`/collection-group rule can only safely reference fields the
    // query itself filters on (confirmed empirically — see
    // `docs/FIREBASE.md` §6, "Rules quirks"; the cross-cart alerts query is
    // manager+ only). The query filters solely on `institutionId`
    // (a denormalized field every assignment doc carries, written once at
    // creation — see `FirestoreInventoryRepository.createAssignment`), so
    // this rule touches only that field too; it deliberately does NOT also
    // check `isAssignedToCart`, which needs `cartId` — a field the query
    // does not filter on — because doing so throws "Property cartId is
    // undefined on object" for any denied candidate document instead of
    // just excluding it, failing the whole query. A normal (non-manager)
    // user already sees their own responsible carts' assignments in full
    // via the ordinary per-cart `watchAssignments` reads below; they simply
    // don't get the cross-cart aggregate view.
    // D16: Admin/Super only; a Manager reads their carts one by one.
    match /{path=**}/assignments/{assignmentId} {
      allow read: if isInstitutionAdmin(resource.data.institutionId);
    }

    match /institutions/{institutionId} {
      allow read: if isMember(institutionId);
      // Only a platform super admin creates institutions (spec section 16).
      allow create: if isPlatformSuperAdmin();
      allow update: if isInstitutionAdmin(institutionId) &&
        onlyChangedFields(['name', 'expiryWarningDays', 'updatedAt', 'updatedBy']);
      allow delete: if false;

      match /memberships/{uid} {
        allow read: if isMember(institutionId);
        allow create: if isInstitutionAdmin(institutionId) && request.resource.data.uid == uid;
        // No one may change or remove their own membership: prevents
        // self-escalation and self-reactivation after being disabled
        // (spec sections 18, 60).
        allow update: if isInstitutionAdmin(institutionId) && request.auth.uid != uid;
        allow delete: if isInstitutionAdmin(institutionId) && request.auth.uid != uid;

        // DB3: credentials are set by the administration only. Today this
        // holds the PIN hash (INTERIM under Firebase: the user can read their
        // own hash so the device can check the PIN offline; a 4-digit PIN
        // can be brute-forced from it. The real check moves to the
        // institution's server). Nobody writes their own, not even an admin.
        match /private/{docId} {
          allow read: if docId == 'credentials' &&
            ((isMember(institutionId) && request.auth.uid == uid) || isInstitutionAdmin(institutionId));
          allow create, update: if docId == 'credentials' &&
            isInstitutionAdmin(institutionId) &&
            request.auth.uid != uid &&
            request.resource.data.pinHash is string &&
            request.resource.data.pinHash.matches('^pbkdf2-sha256[$][0-9]+[$][A-Za-z0-9+/=]+[$][A-Za-z0-9+/=]+$');
          allow delete: if false;
        }
      }

      // D16: the catalogue is the Admin's.
      match /products/{productId} {
        allow read: if isMember(institutionId);
        allow write: if isInstitutionAdmin(institutionId);
      }

      match /carts/{cartId} {
        // Split get/list, confirmed empirically necessary (firebase-tools
        // 15.29.0's Firestore emulator): a `list` query on this collection
        // cannot reference this document's own identity at all -- neither
        // the `cartId` path wildcard nor `resource.data`/`resource.id` --
        // without throwing "Null value error"/"Property ... is undefined
        // on object" for every candidate document, even for a caller whose
        // first `||` branch (`isInstitutionAdmin`) is statically true and
        // never itself touches `resource`. `get` (single-document reads,
        // used by `getCart`) has no such limitation and keeps using the
        // richer `responsibleUsers`-subcollection check via
        // `canAccessCart`. `list` (used by `watchAccessibleCarts`) instead
        // needs the caller to shape its query to match this rule exactly:
        // an Admin/Super lists the collection unfiltered (this branch never
        // touches `resource`, so it is safe); a Manager must filter by
        // `responsibleUserIds array-contains <their uid>`, matching the
        // denormalized array field `FirestoreCartRepository.assignResponsibleUser`/
        // `removeResponsibleUser` keep in sync on the cart doc itself. See
        // docs/FIREBASE.md for the full empirical story -- this is
        // the same class of bug already documented there for `memberIndex`
        // and the cross-cart `assignments` collection-group query, just
        // manifesting on a plain (non-collection-group) nested collection
        // this time.
        allow get: if canAccessCart(institutionId, cartId);
        allow list: if isInstitutionAdmin(institutionId) ||
          (isMember(institutionId) && request.auth.uid in resource.data.responsibleUserIds);
        allow create: if isInstitutionAdmin(institutionId);
        // D16: a Manager registered to the cart may change its state only.
        allow update: if isInstitutionAdmin(institutionId) ||
          (canAccessCart(institutionId, cartId) && onlyChangedFields(['status', 'updatedAt', 'updatedBy']));
        allow delete: if false;

        // Who is registered to the cart: set by the Admin (P18).
        match /responsibleUsers/{uid} {
          allow read: if canAccessCart(institutionId, cartId);
          allow write: if isInstitutionAdmin(institutionId);
        }

        // Drawers are never deleted. A used drawer keeps its grid, and its
        // number unless it never had one (P1/P2, Q8).
        match /drawers/{drawerId} {
          allow read: if canAccessCart(institutionId, cartId);
          allow create: if isInstitutionAdmin(institutionId) && !('usedAt' in request.resource.data) && drawerNameValid();
          // The optional name (D20) isn't structure: a used drawer may be renamed.
          allow update: if (isInstitutionAdmin(institutionId) && usedAtKept() && drawerNameValid() &&
              (!isUsed() || (unchanged('rows') && unchanged('columns') &&
                (!('number' in resource.data) || unchanged('number'))))) ||
            (canAccessCart(institutionId, cartId) && onlyMarksUsed());
          allow delete: if false;

          // A used slot keeps its place and size and can't be deleted.
          match /slots/{slotId} {
            allow read: if canAccessCart(institutionId, cartId);
            allow create: if isInstitutionAdmin(institutionId) && !('usedAt' in request.resource.data);
            allow update: if (isInstitutionAdmin(institutionId) && usedAtKept() &&
                (!isUsed() || (unchanged('row') && unchanged('column') && unchanged('rowSpan') && unchanged('columnSpan')))) ||
              (canAccessCart(institutionId, cartId) && onlyMarksUsed());
            allow delete: if isInstitutionAdmin(institutionId) && !isUsed();
          }
        }

        match /assignments/{assignmentId} {
          allow read: if canAccessCart(institutionId, cartId);
          // The denormalized `institutionId`/`cartId` fields (see
          // `FirestorePaths.assignmentsCollectionGroup`) must always match
          // this document's own path and can never be changed afterward by
          // anyone — otherwise a manager of one institution could make an
          // assignment readable to a different institution's `list` query
          // via the collection-group rule above, which trusts these fields.
          allow create: if isInstitutionAdmin(institutionId) &&
            request.resource.data.institutionId == institutionId &&
            request.resource.data.cartId == cartId &&
            stockWithinTarget(request.resource.data) &&
            !('usedAt' in request.resource.data);
          // P1: a placement with History can't be deleted.
          allow delete: if isInstitutionAdmin(institutionId) && !isUsed();
          // D16: a Manager registered to the cart changes the stock
          // (consumption, replenishment, the monthly check) but no structural
          // field: slot, drawer, product and target stay the Admin's.
          // A used placement keeps its slot and its product (P1, DATABASE.md
          // §2.3 trigger on SLOTCC).
          allow update: if (isInstitutionAdmin(institutionId) ||
              (canAccessCart(institutionId, cartId) &&
                onlyChangedFields(['currentQuantity', 'earliestKnownExpiry', 'updatedAt', 'updatedBy', 'usedAt']))) &&
            request.resource.data.institutionId == resource.data.institutionId &&
            request.resource.data.cartId == resource.data.cartId &&
            stockUpdateAllowed() &&
            usedAtKept() &&
            (!isUsed() || (unchanged('slotId') && unchanged('drawerId') && unchanged('productId')));

          // DB1: a batch is the units of one slot with the same expiry date.
          // Batches are never deleted; a batch confirmed gone gets `removedAt`.
          // D16: whoever works on the cart adds and removes batches.
          match /batches/{batchId} {
            allow read: if canAccessCart(institutionId, cartId);
            // A new batch needs its quantity (> 0) and expiry date; the lot
            // number is optional (P9).
            allow create: if canAccessCart(institutionId, cartId) &&
              request.resource.data.quantity is int &&
              request.resource.data.quantity > 0 &&
              request.resource.data.expiryDate is timestamp &&
              !('removedAt' in request.resource.data);
            // The only change is marking it removed, once (P21).
            allow update: if canAccessCart(institutionId, cartId) &&
              !('removedAt' in resource.data) &&
              onlyChangedFields(['removedAt', 'updatedAt']);
            allow delete: if false;
          }
        }
      }

      // Immutable operational stock history (spec sections 24, 43-45, 60).
      match /usageEvents/{eventId} {
        allow read: if isMember(institutionId);
        allow create: if isMember(institutionId) &&
          request.resource.data.actorUid == request.auth.uid &&
          canAccessCart(institutionId, request.resource.data.cartId) &&
          // DATABASE.md HISTORY `reason` VARCHAR(500), optional.
          (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500));
        allow update, delete: if false;
      }

      // Immutable administrative/audit trail (spec sections 18, 45, 60).
      match /auditEvents/{eventId} {
        allow read: if isInstitutionAdmin(institutionId);
        allow create: if isMember(institutionId) && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
