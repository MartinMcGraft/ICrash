<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build only: allows plain HTTP to the Firebase Local Emulator Suite
  (Auth/Firestore), which serves cleartext and is otherwise blocked by
  Android's default cleartext-traffic policy. 10.0.2.2 is how the Android
  emulator reaches the host machine's 127.0.0.1; localhost/127.0.0.1 cover a
  physical device on adb reverse or a host-network emulator config. Release
  builds have no such override and always use HTTPS (see AppEnvironment).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
